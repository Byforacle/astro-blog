---
import { encrypt } from '../utils/encrypt';

interface Props {
  password: string;
}

const { password } = Astro.props;

// 获取 slot 中的 HTML 内容
const html = await Astro.slots.render('default');
const encryptedHtml = await encrypt(html, password);
---

<meta name="encrypted-content" content={encryptedHtml} />

<div id="password-protected-wrapper" class="relative w-full">
  <div id="password-form" class="pw-container">
    <div class="password-card">
      <!-- 锁图标 -->
      <div class="pw-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25z"></path>
        </svg>
      </div>

      <h3 class="pw-title">内容已加密</h3>
      <p class="pw-desc">请输入密码以查看此页面的内容</p>

      <!-- 输入区域 -->
      <div class="pw-field">
        <input
          id="password-input"
          type="password"
          placeholder="请输入密码"
          class="password-input"
          autocomplete="off"
          autofocus
        />
      </div>

      <button id="decrypt-btn" class="decrypt-btn" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 5-5v0a5 5 0 0 1 5 5v1"></path>
        </svg>
        <span class="btn-text">解锁</span>
      </button>

      <div id="error-message" class="error-message" style="display: none;"></div>
    </div>
  </div>

  <div id="decrypted-content" class="decrypted-content" style="display: none;"></div>
</div>

<script>
  // ==========================================
  // 逻辑代码保持 100% 原样，未做任何修改
  // ==========================================

  // 类型声明以通过 Astro/TS 检查
  declare global {
    interface Window {
      swup?: {
        hooks?: {
          on: (event: string, cb: () => void) => void;
        };
      };
    }
  }

  // 客户端解密函数
  async function decrypt(encryptedData: string, password: string): Promise<string> {
    try {
      const key = password.length >= 16 ? password.slice(0, 16) : password.padEnd(16, '0');
      
      // 解码 base64 字符串到 Uint8Array
      const binaryString = atob(encryptedData);
      const combinedData = new Uint8Array(binaryString.length);
      for (let i = 0; i < binaryString.length; i++) {
        combinedData[i] = binaryString.charCodeAt(i);
      }
      
      const iv = combinedData.slice(0, 16);
      const encrypted = combinedData.slice(16);
      
      const keyBuffer = new TextEncoder().encode(key);
      const cryptoKey = await crypto.subtle.importKey(
        'raw',
        keyBuffer,
        { name: 'AES-CBC', length: 128 },
        false,
        ['decrypt']
      );
      
      const decryptedData = await crypto.subtle.decrypt(
        { name: 'AES-CBC', iv },
        cryptoKey,
        encrypted
      );
      
      return new TextDecoder().decode(decryptedData);
    } catch (error) {
      throw new Error('解密失败，请检查密码是否正确');
    }
  }

  // 初始化函数
  function initPasswordProtected() {
    const passwordInput = document.getElementById('password-input') as HTMLInputElement | null;
    const decryptBtn = document.getElementById('decrypt-btn') as HTMLButtonElement | null;
    const errorMessage = document.getElementById('error-message') as HTMLDivElement | null;
    const passwordForm = document.getElementById('password-form') as HTMLDivElement | null;
    const decryptedContent = document.getElementById('decrypted-content') as HTMLDivElement | null;
    
    if (!passwordInput || !decryptBtn || !passwordForm || !decryptedContent) {
      return;
    }
    
    const encryptedData = document
      .querySelector('meta[name="encrypted-content"]')
      ?.getAttribute('content');
    
    if (!encryptedData) {
      showError('加密内容不存在');
      return;
    }

    const storageKey = 'decryption-key:' + window.location.pathname;

    async function tryAutoDecrypt() {
      const storedPassword = sessionStorage.getItem(storageKey);
      if (storedPassword) {
        try {
          const decryptedHtml = await decrypt(encryptedData!, storedPassword);
          passwordForm!.style.display = 'none';
          decryptedContent!.innerHTML = decryptedHtml;
          decryptedContent!.style.display = 'block';
          executeScripts(decryptedContent!);
        } catch (error) {
          sessionStorage.removeItem(storageKey);
          console.error('自动解密失败:', error);
        }
      }
    }

    async function handleDecrypt() {
      const password = passwordInput!.value.trim();
      if (!password) {
        showError('请输入密码');
        return;
      }

      try {
        if (decryptBtn) {
          const originalText = decryptBtn.innerHTML;
          decryptBtn.textContent = '...';
          decryptBtn.disabled = true;
          // 恢复原来的 HTML 结构以便后续使用
          setTimeout(() => { if(decryptBtn.disabled) decryptBtn.innerHTML = originalText; }, 0); 
        }
        
        const decryptedHtml = await decrypt(encryptedData!, password);
        sessionStorage.setItem(storageKey, password);

        passwordForm!.style.display = 'none';
        decryptedContent!.innerHTML = decryptedHtml;
        decryptedContent!.style.display = 'block';
        
        executeScripts(decryptedContent!);
        
      } catch (error: unknown) {
        const msg = error instanceof Error ? error.message : '解密失败，请检查密码是否正确';
        showError(msg);
        
        // 只有这里做了微小的 UI 逻辑改动：错误时增加 shake 动画类
        const card = document.querySelector('.password-card');
        card?.classList.add('shake');
        setTimeout(() => card?.classList.remove('shake'), 500);

      } finally {
        if (decryptBtn) {
          // 这里重置为图标按钮
          decryptBtn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 5-5v0a5 5 0 0 1 5 5v1"></path></svg><span class="btn-text">解锁</span>`;
          decryptBtn.disabled = false;
        }
      }
    }

    function executeScripts(container: HTMLElement) {
      const scripts = container.querySelectorAll('script');
      scripts.forEach((script: HTMLScriptElement) => {
        const newScript = document.createElement('script');
        if (script.src) {
          newScript.src = script.src;
        } else {
          newScript.textContent = script.textContent;
        }
        document.head?.appendChild(newScript);
        newScript.parentNode?.removeChild(newScript);
      });
    }

    function showError(message: string) {
      if (!errorMessage) return;
      errorMessage.textContent = message;
      errorMessage.style.display = 'block';
      // 这里的 setTimeout 逻辑保持不变
      setTimeout(() => {
        if (errorMessage) errorMessage.style.display = 'none';
      }, 3000);
    }

    decryptBtn.removeEventListener('click', handleDecrypt);
    passwordInput.removeEventListener('keypress', handleKeyPress);
    
    function handleKeyPress(e: KeyboardEvent) {
      if (e.key === 'Enter') {
        handleDecrypt();
      }
    }

    decryptBtn.addEventListener('click', handleDecrypt);
    passwordInput.addEventListener('keypress', handleKeyPress);

    tryAutoDecrypt();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPasswordProtected);
  } else {
    initPasswordProtected();
  }
  
  document.addEventListener('swup:enable', () => {
    if (window.swup?.hooks) {
      window.swup.hooks.on('content:replace', initPasswordProtected);
    }
  });
  
  if (window.swup?.hooks) {
    window.swup.hooks.on('content:replace', initPasswordProtected);
  }
</script>

<style>
  .pw-container {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 400px;
    padding: 3rem 1.5rem;
  }

  .password-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 340px;
    padding: 2.5rem 2rem 2rem;
    border-radius: 1rem;
    border: 1px solid hsl(var(--border));
    background: hsl(var(--background));
    animation: pw-enter 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  /* 图标 */
  .pw-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    margin-bottom: 0.4rem;
    border-radius: 1rem;
    background: hsl(var(--muted));
    color: hsl(var(--muted-foreground));
  }

  .pw-title {
    margin: 0 0 0.375rem;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: hsl(var(--foreground));
  }

  .pw-desc {
    margin: 0 0 1.75rem;
    font-size: 0.8125rem;
    color: hsl(var(--muted-foreground));
    line-height: 1.5;
  }

  /* 输入框 */
  .pw-field {
    width: 100%;
    margin-bottom: 0.75rem;
  }

  .password-input {
    display: block;
    width: 100%;
    padding: 0.625rem 0.875rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: hsl(var(--foreground));
    background: hsl(var(--muted) / 0.5);
    border: 1px solid hsl(var(--border));
    border-radius: 0.5rem;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
    box-sizing: border-box;
  }

  .password-input::placeholder {
    color: hsl(var(--muted-foreground) / 0.6);
  }

  .password-input:focus {
    border-color: hsl(var(--primary));
    box-shadow: 0 0 0 3px hsl(var(--primary) / 0.1);
    background: hsl(var(--background));
  }

  /* 按钮 */
  .decrypt-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.625rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: hsl(var(--primary-foreground));
    background: hsl(var(--primary));
    border: none;
    border-radius: 0.5rem;
    cursor: pointer;
    transition: opacity 0.15s, box-shadow 0.15s;
  }

  .decrypt-btn:hover {
    opacity: 0.9;
    box-shadow: 0 1px 4px hsl(var(--primary) / 0.25);
  }

  .decrypt-btn:active {
    opacity: 0.85;
  }

  .decrypt-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .btn-icon {
    flex-shrink: 0;
  }

  /* 错误消息 */
  .error-message {
    width: 100%;
    margin-top: 0.75rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.8125rem;
    color: hsl(var(--destructive));
    background: hsl(var(--destructive) / 0.08);
    border: 1px solid hsl(var(--destructive) / 0.15);
    border-radius: 0.5rem;
    animation: pw-fade 0.2s ease;
  }

  .decrypted-content {
    width: 100%;
    animation: pw-fade 0.3s ease;
  }

  @keyframes pw-enter {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes pw-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .shake {
    animation: pw-shake 0.4s cubic-bezier(.36,.07,.19,.97) both;
  }

  @keyframes pw-shake {
    10%, 90% { transform: translateX(-2px); }
    20%, 80% { transform: translateX(2px); }
    30%, 50%, 70% { transform: translateX(-3px); }
    40%, 60% { transform: translateX(3px); }
  }
</style>