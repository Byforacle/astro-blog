---
import { Button, Collapse, Spoiler, Timeline } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import Substats from '@/components/about/Substats.astro'
import ToolSection from '@/components/about/ToolSection.astro'

const headings = [
  { depth: 2, slug: 'education', text: 'Education' },
  { depth: 2, slug: 'hobbies', text: 'Hobbies' },
  { depth: 2, slug: 'tools', text: 'Tools' },
  { depth: 2, slug: 'about-blog', text: 'About Blog' }
]
---

<PageLayout title='About' {headings} comment>
  <p><b>Master Student / Developer</b></p>
  <p>
    Hello! I am pursuing my Master’s degree in School of Cyber Science and Engineering, SEU , advised by Prof. <a href='https://jpdz.github.io/pengjiang/' target='_blank'>Jiang Peng</a>. My research focus is on system security.
  </p>
  <p>
    I'm passionate about artificial intelligence and cybersecurity. Here I share my life and notes<br><b>welcome to visit!</b>
  </p>
  <Substats
    stats={[
      {
        platform: 'GitHub',
        icon: 'github',
        link: 'https://github.com/Byforacle',
        text: 'followers',
        api: 'github/Byforacle'
      },
      {
        platform: 'Steam',
        icon: 'steam',
        color: '#50769d',
        link: 'https://steamcommunity.com/profiles/76561198434371970/',
        text: 'games',
        api: 'steamgames/76561198434371970'
      },
      {
        platform: 'Bilibili',
        icon: 'bilibili',
        color: '#ff6699',
        link: 'https://space.bilibili.com/249646919',
        text: 'followers',
        api: 'bilibili/249646919',
        count: 18
      },
      {
        platform: 'Steam',
        icon: 'steam',
        color: '#50769d',
        link: 'https://steamcommunity.com/profiles/76561198434371970/',
        text: 'friends',
        api: 'steamfriends/76561198434371970'
      },
    ]}
  />
  <Button title='Sponsor Me' class='w-fit' href='/projects#sponsorship' variant='ahead' />

  {/* education */}
  <h2 id='education'>Education</h2>
  <Timeline
    events={[
      {
        date: '2022-09',
        content:
          '吉林大学，网络空间安全，本科'
      },
      {
        date: '2026-09',
        content:
          '东南大学，网络空间安全，硕士'
      }
    ]}
  />

  {/* general-talk */}
  <h2 id='hobbies'>Hobbies</h2>
  <ul>
    <li>游戏🎮，各种领域都会尝试<Spoiler>，最近比较喜欢类魂和类银😋</Spoiler></li>
    <li>
      ACG爱好者<Spoiler>，最近看的比较少，但是老二次元</Spoiler>
    </li>
    <li>户外运动(🏃，🏸)，旅行✈️</li>
  </ul>

  {/* tools */}
  <h2 id='tools'>Tools</h2>
  <p>Used tools as follows:</p>
  <ToolSection
    class='mb-5'
    title='Productivity'
    tools={[
      {
        name: 'Chrome',
        description: 'Browser',
        href: 'https://www.google.com/chrome/',
        icon: import('@/assets/tools/chrome.svg?raw')
      },
      {
        name: 'Typora',
        description: 'Markdown Editor',
        href: 'https://typora.io/',
        icon: import('@/assets/tools/typora.svg?raw')
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='Development'
    tools={[
      {
        name: 'VS Code',
        description: 'IDE',
        href: 'https://code.visualstudio.com/',
        icon: import('@/assets/tools/vscode.svg?raw')
      },
      {
        name: 'Intellij Idea',
        description: 'IDE',
        href: 'https://www.jetbrains.com/zh-cn/idea/',
        icon: import('@/assets/tools/idea_new.svg?raw')
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='Environment'
    tools={[
      {
        name: 'Kali Linux',
        description: 'Linux Distribution',
        href: 'https://www.kali.org/',
        icon: import('@/assets/tools/kali.svg?raw')
      },
      {
        name: 'Ubuntu 24.04 LTS',
        description: 'Linux Distribution',
        href: 'https://ubuntu.com/',
        icon: import('@/assets/tools/ubuntu.svg?raw')
      },
      {
        name: 'MacOS',
        description: 'MacBook Air',
        href: 'https://www.apple.com/macos/',
        icon: import('@/assets/tools/apple.svg?raw')
      },
      {
        name: 'Windows 11',
        description: 'Lenovo Y9000P',
        href: 'https://news.microsoft.com/windows11-general-availability/',
        icon: import('@/assets/tools/windows11.svg?raw')
      }
    ]}
  />

  <!-- {/* gossips */}
  <h2 id='gossips'>Gossips</h2>
  <Collapse title='Lorem ipsum'>
    Lorem ipsum dolor sit amet, vidit suscipit at mei. Quem denique mea id. Usu ei regione indoctum
    dissentiunt, cu meliore fuisset mei, vel quod voluptua ne. Ex dicat impedit mel, at eum oratio
    possit voluptatum.
  </Collapse> -->

  {/* about-blog */}
  <h2 id='about-blog'>About Blog</h2>
  <p>Website history:</p>
  <Timeline
    events={[
      {
        date: '2025-09-28',
        content:
          'Website migration to a new domain <a href="https://orac1e.me/" target="_blank">orac1e.me</a>'
      },
      {
        date: '2025-10-02',
        content:
          'Website refactored using <a href="https://astro.build/" target="_blank">Astro</a> and <a href="https://github.com/srleom/astro-theme-resume" target="_blank">Astro Theme Resume</a>'
      },
      {
        date: '2025-10-03',
        content: 'Configure <a href="https://dash.cloudflare.com/" target="_blank">Cloudflare</a> CDN Acceleration'
      }
    ]}
  />
  <p>
    The smooth operation and personalized customization of website also rely on the resources and
    technical support provided by the following excellent projects/service providers:
  </p>
  <ul>
    <li>Domain: <a href='#' target='_blank'>Aliyun</a></li>
    <li>
      Framework & Theme: <a href='https://astro.build/' target='_blank'>Astro</a> + <a
        href='https://github.com/cworld1/astro-theme-pure'
        target='_blank'>Astro Theme Pure</a
      >
    </li>
    <li>
      Site hosting: <a href='https://vercel.com/' target='_blank'>Vercel</a>
    </li>
    <!-- <li>Resources speedup: <a href='https://cdn.cbd.int/' target='_blank'>CBD CDN</a></li> -->
    <li>Comment system: <a href='https://supabase.com/' target='_blank'>Supabase</a> +
      <a href='https://waline.js.org/' target='_blank'>Waline</a></li>
    <li>
      Other statistics: <a href='https://github.com/spencerwooo/substats' target='_blank'
        >Substats</a
      >
    </li>
  </ul>
</PageLayout>
