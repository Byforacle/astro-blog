---
import { Image } from 'astro:assets'

import { Button, Collapse, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'
import Sponsors from '@/components/projects/Sponsors.astro'
import Sponsorship from '@/components/projects/Sponsorship.astro'
import alipay from '@/assets/alipay-qrcode.jpg'
import KeyIcon from '@/assets/icons/key.svg'
import wechat from '@/assets/wechat-qrcode.jpg'

const headings = [
  { depth: 2, slug: 'applications', text: 'Applications' },
  { depth: 2, slug: 'programs', text: 'Programs' },
  { depth: 2, slug: 'others', text: 'Others' },
  { depth: 2, slug: 'sponsorship', text: 'Sponsorship' }
]
---

<PageLayout title='Projects' {headings} view>
  <p>Github Activities:</p>
  <p>
    <Image
      src='https://ghchart.rshah.org/659eb9/Byforacle'
      alt='github activities'
      inferSize
      loading='lazy'
    />
  </p>
  <p>
    If you think it would be useful or interesting to collaborate on a project, you can contact me to discuss.
  </p>
  <Button title='Checkout sponsorship' class='w-fit' href='#sponsorship'>
    <Icon class='size-5' name='receive-money' slot='before' />
  </Button>

  <h2 id='applications'>Applications</h2>
  <ProjectSection
    projects={[
      {
        name: '🕸️ Astro-Blog',
        description: 'A simple, clean but powerful blog theme build by astro.',
        links: [
          { type: 'github', href: 'https://github.com/Byforacle/astro-blog' },
          { type: 'site', href: 'https://orac1e.me' },
          {
            type: 'doc',
            href: 'https://astro-pure.js.org/docs'
          }
        ]
      }
    ]}
  />

  <h2 id='programs'>Programs</h2>
  <ProjectSection
    projects={[
      {
        name: '🔧 depTool',
        description:
          'Functional Dependency Graph and dependency code Extraction Script for Multilingual Projects',
        links: [
          { type: 'github', href: 'https://github.com/Byforacle/depTool' }
          // {
          //   type: 'release',
          //   href: 'https://github.com/cworld1/notie/releases'
          // }
        ]
      }
    ]}
  />
  <!-- <Collapse title='Some old projects'>
    <ProjectSection
      projects={[

      ]}
    />
  </Collapse> -->

  <h2 id='others'>Others</h2>
  <ProjectSection
    projects={[
      {
        name: '📝 JLU-Exp',
        description: "JLU Lab Course Code and Report Archive",
        links: [{ type: 'github', href: 'https://github.com/Byforacle/JLU-Exp' }]
      }
    ]}
  />

  <!-- sponsorship -->
  <h2 id='sponsorship'>Sponsorship</h2>
  <p>Please leave a message or contact me proactively after sponsorship.</p>
  <Sponsorship
    methods={[
      { name: 'WeChat', icon: 'wechat-pay', image: wechat },
      { name: 'Alipay', icon: 'alipay', image: alipay }
    ]}
  />
  <p>Thanks to the following sponsors:</p>
  <Sponsors
    sponsors={[
      { name: 'Orac1e(QQ: 7396***57)', amount: '5.00', date: '2025-09-28' },
      { name: 'Anonymous', amount: '20.00', date: '2025-10-03' }
    ]}
  />
</PageLayout>

<style>
  .sponsorship-card {
    & .sponsorship-card-img {
      opacity: 0.3;
      --un-blur: blur(4px);
      filter: var(--un-blur);
    }

    &:hover {
      & .sponsorship-card-icon {
        opacity: 0;
      }
      & .sponsorship-card-img {
        opacity: 1;
        --un-blur: blur(0);
      }
    }
  }
</style>
